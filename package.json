{
  "name": "dsh-kernel-codex",
  "version": "0.3.2",
  "description": "The Codex CLI persona as a DSH agent preset: one system-prompt section, adapted to the DSH tool surface, with no tools of its own.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/system-prompt.js",
    "lib/codex-config.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "README.zh.md",
    "README.i18n.yaml",
    "AGENTS.md",
    "AGENTS.zh-CN.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --check lib/index.js && node --check lib/system-prompt.js && node test/smoke.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "codex",
    "persona",
    "prompt"
  ],
  "homepage": "https://github.com/oppnc/dsh-kernel-codex#readme",
  "bugs": {
    "url": "https://github.com/oppnc/dsh-kernel-codex/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oppnc/dsh-kernel-codex.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
